project Test is

   for Target use "llvm";
   for Object_Dir use ".objs";
   for Source_Dirs use (".");
   for Main use ("main.adb");
   for Exec_Dir use ".";

   package Compiler is
      for Switches ("Ada") use ("--target=wasm32", "-O1");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-z");
   end Binder;

end Test;
