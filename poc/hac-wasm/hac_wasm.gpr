--  Build HAC (the Ada compiler) for wasm32 against the EH-enabled runtime.
--  HAC sources are expected at /opt/hac (see build-hac.sh).

project HAC_Wasm is

   for Target use "llvm";
   for Object_Dir use ".objs";
   for Source_Dirs use
     (".", "/opt/hac/src", "/opt/hac/src/compile", "/opt/hac/src/compile/emit",
      "/opt/hac/src/execute", "/opt/hac/src/manage");
   for Main use ("main.adb");
   for Exec_Dir use ".";

   package Compiler is
      for Switches ("Ada") use ("--target=wasm32", "-O1", "-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-z");
   end Binder;

end HAC_Wasm;
